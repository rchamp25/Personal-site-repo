---
import type { TransitionDirectionalAnimations } from "astro";
import { getEntry } from "astro:content";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import GraphiteDust from "../components/GraphiteDust.astro";
import SectionLabel from "../components/SectionLabel.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  // Page name for the document title. Omit on the home page.
  title?: string;
  // Running index label for this page, e.g. "Home".
  label: string;
  // Home only: the label joins the first-load sequence (see global.css).
  intro?: boolean;
  // The page's sections, in order, for the running index in the left margin
  // (desktop). `id` is the id of the section's heading or wrapper. Shown only
  // when there are two or more.
  sections?: { id: string; label: string }[];
  // Meta and social description for this page; "{name}" becomes the profile
  // name. Defaults to name and role.
  description?: string;
}
const { title, label, intro = false, sections = [], description } = Astro.props;

const profile = await getEntry("profile", "ross");
if (!profile) throw new Error('Missing profile entry "ross" in src/content/profile.yaml');
// "Ross Champlin" on the home page, "Projects · Ross Champlin" elsewhere.
const documentTitle = title ? `${title} · ${profile.data.name}` : profile.data.name;

// Sharing: one canonical address per page (no trailing slash; the site
// answers on both), a description, and the social preview image built by
// `npm run share-images`. `site` (astro.config.mjs) is the origin.
const { name, role } = profile.data;
const pageDescription =
  description?.replaceAll("{name}", name) ??
  (role.startsWith("Placeholder") ? `${name}: projects, experience, and contact.` : `${name}, ${role}.`);
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site);
const shareImage = new URL("/og.png", Astro.site);

// Page change: the content leaves with a short rise and fade (page-leave) and
// the next page arrives the same way (page-arrive), both directions, on the
// motion tokens; the keyframes are in global.css. Header and footer are named
// separately with "none" (SiteHeader, SiteFooter), so they hold still. Reduced
// motion turns all of it off (global.css, plus Astro's own rule).
const pageMotion = {
  duration: "var(--duration-page)",
  easing: "var(--ease-out-quart)",
  fillMode: "both",
};
const pageChange = {
  old: { ...pageMotion, name: "page-leave" },
  new: { ...pageMotion, name: "page-arrive" },
};
const pageTransition: TransitionDirectionalAnimations = {
  forwards: pageChange,
  backwards: pageChange,
};
---

<html lang="en" transition:animate={pageTransition}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#12110f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${name}, ${role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
  </head>
  <!-- No background on <body>: <html> paints the ground, so the graphite
       dust canvas (z-index -1) shows through behind the content. -->
  <body class="flex min-h-dvh flex-col font-body text-ink">
    <GraphiteDust />
    <a
      href="#main"
      class="sr-only font-meta text-xs focus:not-sr-only focus:absolute focus:top-2 focus:left-4 focus:z-20 focus:bg-ground focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <SiteHeader />
    <!-- Wide screens: index label in the left margin, content to its right.
         Small screens: the label stacks above the content.
         tabindex="-1" lets the skip link move focus here; main is not a control,
         so it shows no focus ring. -->
    <main
      id="main"
      tabindex="-1"
      class="outline-none mx-auto w-full max-w-page flex-1 px-4 py-10 sm:px-8 md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-8 md:py-16"
    >
      <div class="mb-8 md:sticky md:top-24 md:mb-0 md:self-start" data-intro={intro ? "" : undefined}>
        <SectionLabel>{label}</SectionLabel>
        {
          sections.length > 1 && (
            // Running index (desktop): the section being read is ink
            // (aria-current, set by the script below); the track beside the
            // list fills with page scroll (global.css, .index-progress).
            <nav aria-label="On this page" class="relative mt-6 hidden pl-4 md:block">
              <span aria-hidden="true" class="index-track" />
              <span aria-hidden="true" class="index-progress" />
              <ol class="space-y-2 font-meta text-xs">
                {sections.map(({ id, label: sectionLabel }, i) => (
                  <li>
                    <a href={`#${id}`} class="index-link" data-index-target={id}>
                      <span class="tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                      <span>{sectionLabel}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </div>
      <div>
        <slot />
      </div>
    </main>
    <SiteFooter />
    <!-- Vercel Web Analytics: no cookies. Inside <body> so each client-side
         page change (ClientRouter swaps the body) counts as a page view.
         Collects only once Web Analytics is enabled for the project in Vercel. -->
    <Analytics />
    <script>
      // Client-side visits: mark the incoming page so the Home first-load
      // sequence (data-intro in global.css) does not replay. Astro copies the
      // new document's <html> attributes onto the page during the swap.
      document.addEventListener("astro:before-swap", (event) => {
        event.newDocument.documentElement.dataset.nav = "client";
      });

      // Scroll reveal: data-reveal elements that start below the fold are
      // hidden (data-reveal-pending) and shown once, when they scroll into
      // view. Elements already in view are left alone. Reduced motion skips it.
      let observer: IntersectionObserver | undefined;
      document.addEventListener("astro:page-load", () => {
        observer?.disconnect();
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              (entry.target as HTMLElement).removeAttribute("data-reveal-pending");
              observer?.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        for (const el of document.querySelectorAll<HTMLElement>("[data-reveal]")) {
          if (el.getBoundingClientRect().top < innerHeight) continue;
          el.dataset.revealPending = "";
          observer.observe(el);
        }
      });

      // Running index: mark the section being read. A section is current once
      // its top passes 35% of the viewport; at the very bottom of the page the
      // last section is current. Reads positions only; never moves the scroll.
      let onIndexScroll: (() => void) | undefined;
      document.addEventListener("astro:page-load", () => {
        if (onIndexScroll) removeEventListener("scroll", onIndexScroll);
        onIndexScroll = undefined;
        const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-index-target]")];
        if (links.length === 0) return;
        const targets = links.map((link) => {
          const el = document.getElementById(link.dataset.indexTarget ?? "");
          return el?.closest("section") ?? el;
        });
        let frame = 0;
        const update = () => {
          frame = 0;
          const line = innerHeight * 0.35;
          let current = 0;
          targets.forEach((el, i) => {
            if (el && el.getBoundingClientRect().top <= line) current = i;
          });
          const doc = document.documentElement;
          if (scrollY > 0 && innerHeight + scrollY >= doc.scrollHeight - 2) current = links.length - 1;
          links.forEach((link, i) => {
            if (i === current) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          });
        };
        onIndexScroll = () => {
          if (!frame) frame = requestAnimationFrame(update);
        };
        addEventListener("scroll", onIndexScroll, { passive: true });
        update();
      });

      // iOS Safari only applies :active (the row press state) when a touch
      // listener exists.
      document.addEventListener("touchstart", () => {}, { passive: true });
    </script>
  </body>
</html>
