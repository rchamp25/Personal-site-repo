---
// One ruled row on the experience page: title, then org and dates when
// present, bullets, an optional Markdown body, and commentary last.
import { render, type CollectionEntry } from "astro:content";
import { formatRange } from "../lib/dates";

interface Props {
  entry: CollectionEntry<"experience">;
}
const { entry } = Astro.props;
const { title, org, start, end, bullets, commentary } = entry.data;
const dates = formatRange(start, end);
const meta = [org, dates].filter(Boolean);
const hasBody = Boolean(entry.body?.trim());
const { Content } = hasBody ? await render(entry) : { Content: null };
---

<li class="border-b border-hairline py-6">
  <div class="max-w-measure">
    <h3 class="text-2xl leading-tight">{title}</h3>
    {
      meta.length > 0 && (
        <p class="mt-2 font-meta text-xs text-muted">
          {meta.map((part, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <span>{part}</span>
            </>
          ))}
        </p>
      )
    }
    {
      bullets.length > 0 && (
        <ul class="mt-3 list-disc space-y-1 pl-5 leading-relaxed marker:text-muted">
          {bullets.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
      )
    }
    {
      Content && (
        <div class="mt-3 space-y-3 leading-relaxed">
          <Content />
        </div>
      )
    }
    {
      commentary && (
        <div class="mt-5">
          <p class="font-meta text-xs uppercase tracking-wider text-muted">Commentary</p>
          <p class="mt-2 border-l border-hairline pl-4 leading-relaxed text-muted">{commentary}</p>
        </div>
      )
    }
  </div>
</li>
