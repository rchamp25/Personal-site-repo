---
import { getCollection, getEntry } from "astro:content";
import Icon from "./Icon.astro";

const profile = await getEntry("profile", "ross");
if (!profile) throw new Error('Missing profile entry "ross" in src/content/profile.yaml');

// Only links Ross has supplied, as logos; placeholders stay off the footer.
const links = (await getCollection("links", ({ data }) => !data.placeholder && data.href))
  .sort((a, b) => a.data.order - b.data.order);

const year = new Date().getFullYear();
---

<!-- Named for the page change with "none": it holds still (see Base.astro). -->
<footer
  class="border-t border-hairline font-meta text-xs"
  transition:name="site-footer"
  transition:animate="none"
>
  <div class="mx-auto flex max-w-page flex-wrap items-center gap-x-8 gap-y-2 px-4 py-6 sm:px-8">
    <p class="text-muted md:w-44">© {year} {profile.data.name}</p>
    {
      links.length > 0 && (
        <ul class="-m-1.5 flex flex-wrap gap-x-3">
          {links.map(({ data }) => (
            <li>
              <a
                href={data.href}
                aria-label={data.label}
                title={data.text}
                class="flex p-1.5 text-muted transition-[color] duration-(--duration-hover) ease-(--ease-out-quart) hover:text-ink"
              >
                <Icon name={data.icon} class="size-4" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>
