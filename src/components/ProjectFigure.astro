---
// A project's framed plate: a screenshot, or the project's logo for projects
// whose visual is their branding (NailsByGabs, Personal Site). Same 16:10 frame
// for both so the plates line up; a screenshot fills it from the top, a logo
// sits centered with room around it. Until the file is supplied the frame shows
// a labeled placeholder. Thin muted frame and a mono caption, no accent.
import type { CollectionEntry } from "astro:content";
import { Image, Picture } from "astro:assets";

interface Props {
  title: string;
  image: NonNullable<CollectionEntry<"projects">["data"]["image"]>;
  // Rendered width, for the responsive image.
  sizes: string;
  class?: string;
}
const { title, image, sizes, class: className } = Astro.props;
const { kind, src, alt } = image;
const what = kind === "logo" ? "Logo" : "Screenshot";
const fit = kind === "logo" ? "object-contain p-8 sm:p-12" : "object-cover object-top";
// Never wider than the file itself.
const widths = src ? [...new Set([480, 720, 960, 1440].map((w) => Math.min(w, src.width)))] : [];
---

<figure class={className} data-reveal>
  <div class="flex aspect-[16/10] w-full items-center justify-center overflow-hidden border border-muted bg-ground">
    {
      src && alt ? (
        src.format === "svg" ? (
          <Image src={src} alt={alt} loading="lazy" class:list={["h-full w-full", fit]} />
        ) : (
          <Picture
            src={src}
            alt={alt}
            formats={["avif", "webp"]}
            widths={widths}
            quality={85}
            sizes={sizes}
            loading="lazy"
            pictureAttributes={{ class: "block h-full w-full" }}
            class:list={["block h-full w-full", fit]}
          />
        )
      ) : (
        <p class="px-4 text-center font-meta text-xs uppercase tracking-wider text-muted">
          Placeholder: {what.toLowerCase()} coming
        </p>
      )
    }
  </div>
  <figcaption class="mt-3 font-meta text-xs uppercase tracking-wider text-muted">
    {title} · {what}
  </figcaption>
</figure>
