---
// A project's full breakdown: summary, then the facts strip (role, dates,
// stack, and links, up front so they can be scanned before any reading; Ross,
// 2026-10-04), the framed plate (screenshot or logo), The problem, What I built
// (the Markdown body), and commentary, each only when the content has it. Used on a project's own page
// and, for every project, on /projects. `idPrefix` keeps section ids unique
// when several breakdowns share a page; `level` is the heading level of the
// section labels. `titleId`, when several projects share a page, names each
// section after its project ("MixTwin, Problem") so screen readers can tell
// the regions apart. One column reads summary, facts, plate, story, commentary.
// `wide` (on /projects) spreads it over the page from lg: the story (The
// problem, What I built) at the prose measure on the left, the plate and any
// commentary beside it on the right.
import { render, type CollectionEntry } from "astro:content";
import { formatRange } from "../lib/dates";
import Icon from "./Icon.astro";
import ProjectFigure from "./ProjectFigure.astro";

interface Props {
  project: CollectionEntry<"projects">;
  idPrefix?: string;
  level?: 2 | 3;
  titleId?: string;
  wide?: boolean;
}
const { project, idPrefix = "", level = 2, titleId, wide = false } = Astro.props;
const labelledBy = (id: string) => (titleId ? `${titleId} ${id}` : id);
const Label = `h${level}` as "h2" | "h3";
const { title, summary, problem, role, start, end, stack, repo, repoPending, demo, download, image, commentary } =
  project.data;
const { Content } = await render(project);

const details = [
  { label: "Role", value: role },
  { label: "Dates", value: formatRange(start, end) },
  { label: "Stack", value: stack.length > 0 ? stack.join(", ") : undefined },
].filter((d): d is { label: string; value: string } => Boolean(d.value));

const links = [
  { label: "Repo", href: repo },
  { label: "Download for Windows", href: download },
  { label: "See it live", href: demo },
].filter((l): l is { label: string; href: string } => Boolean(l.href));
// A repo that is not public yet: named in the links row, but not a link.
const repoSoon = repoPending && !repo;
const hasFacts = details.length > 0 || links.length > 0 || repoSoon;
---

<!-- The wrapper holds the measure at body size (65ch of the larger summary
     type would run wider than the prose below). -->
<div class="max-w-measure">
  <p class="mt-6 text-xl sm:text-2xl">{summary}</p>
</div>

{
  // The facts strip: label-value pairs on one wrapping line, links under them,
  // between two hairlines.
  hasFacts && (
    <div id={`${idPrefix}details`} class="mt-6 border-y border-hairline py-4">
      {details.length > 0 && (
        <dl class="flex flex-wrap gap-x-8 gap-y-2">
          {details.map(({ label, value }) => (
            <div class="flex items-baseline gap-x-3">
              <dt class="shrink-0 font-meta text-xs uppercase tracking-wider text-muted">{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      )}
      {(links.length > 0 || repoSoon) && (
        <ul class:list={["flex flex-wrap gap-x-6 gap-y-2 font-meta text-sm", details.length > 0 && "mt-3"]}>
          {repoSoon && <li class="text-muted">Repo (coming soon)</li>}
          {links.map(({ label, href }) => (
            <li>
              <a href={href} target="_blank" rel="noopener" class="inline-flex items-center gap-2">
                {label}
                <Icon name="external" class="size-3" />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  )
}

<!-- Wide, from lg: the story spans both rows of the left column, so any
     commentary sits right under the plate instead of waiting for the story to
     end. -->
<div
  class:list={[
    wide && "lg:grid lg:grid-cols-[minmax(0,65ch)_minmax(0,1fr)] lg:grid-rows-[auto_1fr] lg:gap-x-16",
  ]}
>
  {
    image && (
      <ProjectFigure
        title={title}
        image={image}
        sizes={wide ? "(min-width: 1024px) 28rem, (min-width: 640px) 36rem, 100vw" : "(min-width: 640px) 36rem, 100vw"}
        class:list={["mt-10 max-w-measure", wide && "lg:col-start-2 lg:row-start-1 lg:mt-12 lg:max-w-none"]}
      />
    )
  }

  <div class:list={["max-w-measure", wide && "lg:col-start-1 lg:row-span-2 lg:row-start-1"]}>
    <section aria-labelledby={labelledBy(`${idPrefix}problem`)} class="mt-12" data-reveal>
      <Label id={`${idPrefix}problem`} class="font-meta text-xs uppercase tracking-wider text-muted">
        The problem
      </Label>
      <p class="mt-3 text-lg leading-relaxed">{problem}</p>
    </section>

    <section aria-labelledby={labelledBy(`${idPrefix}built`)} class="mt-12" data-reveal>
      <Label id={`${idPrefix}built`} class="font-meta text-xs uppercase tracking-wider text-muted">
        What I built
      </Label>
      <div class="body mt-3 text-lg leading-relaxed">
        <Content />
      </div>
    </section>
  </div>

  {
    commentary && (
      <div class:list={["max-w-measure", wide && "lg:col-start-2 lg:row-start-2 lg:max-w-none"]}>
        <section
          aria-labelledby={labelledBy(`${idPrefix}commentary`)}
          class="draw-rule mt-16 border-t border-hairline pt-8"
          data-reveal
        >
          <Label id={`${idPrefix}commentary`} class="font-meta text-xs uppercase tracking-wider text-muted">
            Commentary
          </Label>
          <p class="mt-3 border-l border-hairline pl-4 leading-relaxed text-muted">{commentary}</p>
        </section>
      </div>
    )
  }
</div>

<style>
  /* Minimal type for the Markdown body (Tailwind's reset strips the defaults).
     Ink, muted, and hairline only. */
  .body :global(* + *) {
    margin-top: 1em;
  }
  .body :global(h2),
  .body :global(h3) {
    margin-top: 1.75em;
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .body :global(ul) {
    list-style: disc;
    padding-left: 1.25em;
  }
  .body :global(ol) {
    list-style: decimal;
    padding-left: 1.25em;
  }
  .body :global(li + li) {
    margin-top: 0.25em;
  }
  .body :global(blockquote) {
    border-left: 1px solid var(--color-hairline);
    padding-left: 1rem;
    color: var(--color-muted);
  }
  .body :global(code) {
    font-family: var(--font-meta);
    font-size: 0.85em;
  }
  .body :global(pre) {
    overflow-x: auto;
    border: 1px solid var(--color-hairline);
    padding: 1rem;
    font-size: 0.875rem;
  }
  .body :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
