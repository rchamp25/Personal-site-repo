---
// A project's full breakdown: summary, Problem, What was built (the Markdown
// body), role/dates/stack, links, image, and commentary, each only when the
// content has it. Used on a project's own page and, for every project, on
// /projects. `idPrefix` keeps section ids unique when several breakdowns share
// a page; `level` is the heading level of the section labels. `titleId`, when
// several projects share a page, names each section after its project
// ("MixTwin, Problem") so screen readers can tell the regions apart. `wide`
// (on /projects) spreads it over the page from lg: the story (summary,
// Problem, What was built) at the prose measure on the left, the facts
// (details, links, image, commentary) beside it on the right.
import { render, type CollectionEntry } from "astro:content";
import { formatRange } from "../lib/dates";
import Icon from "./Icon.astro";

interface Props {
  project: CollectionEntry<"projects">;
  idPrefix?: string;
  level?: 2 | 3;
  titleId?: string;
  wide?: boolean;
}
const { project, idPrefix = "", level = 2, titleId, wide = false } = Astro.props;
const labelledBy = (id: string) => (titleId ? `${titleId} ${id}` : id);
const Label = `h${level}` as "h2" | "h3";
const { summary, problem, role, start, end, stack, repo, demo, image, commentary } = project.data;
const { Content } = await render(project);

const details = [
  { label: "Role", value: role },
  { label: "Dates", value: formatRange(start, end) },
  { label: "Stack", value: stack.length > 0 ? stack.join(", ") : undefined },
].filter((d): d is { label: string; value: string } => Boolean(d.value));

const links = [
  { label: "Repository", href: repo },
  { label: "Live site", href: demo },
].filter((l): l is { label: string; href: string } => Boolean(l.href));
const hasFacts = details.length > 0 || links.length > 0 || Boolean(image) || Boolean(commentary);
---

<div class:list={[wide && "lg:grid lg:grid-cols-[minmax(0,65ch)_minmax(0,1fr)] lg:gap-x-16"]}>
  <div class="max-w-measure">
    <p class="mt-6 text-xl sm:text-2xl">{summary}</p>

    <section aria-labelledby={labelledBy(`${idPrefix}problem`)} class="mt-12" data-reveal>
      <Label id={`${idPrefix}problem`} class="font-meta text-xs uppercase tracking-wider text-muted">
        Problem
      </Label>
      <p class="mt-3 text-lg leading-relaxed">{problem}</p>
    </section>

    <section aria-labelledby={labelledBy(`${idPrefix}built`)} class="mt-12" data-reveal>
      <Label id={`${idPrefix}built`} class="font-meta text-xs uppercase tracking-wider text-muted">
        What was built
      </Label>
      <div class="body mt-3 text-lg leading-relaxed">
        <Content />
      </div>
    </section>
  </div>

  {
    hasFacts && (
      <div class:list={["max-w-measure", wide && "lg:max-w-none lg:[&>:first-child]:mt-8"]}>
        {details.length > 0 && (
          <dl id={`${idPrefix}details`} class="draw-rule mt-12 border-t border-hairline" data-reveal>
            {details.map(({ label, value }) => (
              <div class="grid grid-cols-[6rem_minmax(0,1fr)] gap-x-4 border-b border-hairline py-3">
                <dt class="font-meta text-xs uppercase tracking-wider text-muted">{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        )}

        {links.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-meta text-sm" data-reveal>
            {links.map(({ label, href }) => (
              <li>
                <a href={href} target="_blank" rel="noopener" class="inline-flex items-center gap-2">
                  {label}
                  <Icon name="external" class="size-3" />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )}

        {image && (
          <img
            src={image.src}
            alt={image.alt}
            loading="lazy"
            decoding="async"
            class="mt-12 h-auto w-full border border-hairline"
            data-reveal
          />
        )}

        {commentary && (
          <section
            aria-labelledby={labelledBy(`${idPrefix}commentary`)}
            class="draw-rule mt-16 border-t border-hairline pt-8"
            data-reveal
          >
            <Label id={`${idPrefix}commentary`} class="font-meta text-xs uppercase tracking-wider text-muted">
              Commentary
            </Label>
            <p class="mt-3 border-l border-hairline pl-4 leading-relaxed text-muted">{commentary}</p>
          </section>
        )}
      </div>
    )
  }
</div>

<style>
  /* Minimal type for the Markdown body (Tailwind's reset strips the defaults).
     Ink, muted, and hairline only. */
  .body :global(* + *) {
    margin-top: 1em;
  }
  .body :global(h2),
  .body :global(h3) {
    margin-top: 1.75em;
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .body :global(ul) {
    list-style: disc;
    padding-left: 1.25em;
  }
  .body :global(ol) {
    list-style: decimal;
    padding-left: 1.25em;
  }
  .body :global(li + li) {
    margin-top: 0.25em;
  }
  .body :global(blockquote) {
    border-left: 1px solid var(--color-hairline);
    padding-left: 1rem;
    color: var(--color-muted);
  }
  .body :global(code) {
    font-family: var(--font-meta);
    font-size: 0.85em;
  }
  .body :global(pre) {
    overflow-x: auto;
    border: 1px solid var(--color-hairline);
    padding: 1rem;
    font-size: 0.875rem;
  }
  .body :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
