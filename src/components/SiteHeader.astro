---
import { getEntry } from "astro:content";

const profile = await getEntry("profile", "ross");
if (!profile) throw new Error('Missing profile entry "ross" in src/content/profile.yaml');

const nav = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects" },
  { label: "Experience", href: "/experience" },
  { label: "Contact", href: "/contact" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<!-- Named for the page change with "none": it holds still while the page
     content leaves and arrives (see Base.astro). -->
<header
  class="sticky top-0 z-10 border-b border-hairline bg-ground font-meta text-xs sm:text-sm"
  transition:name="site-header"
  transition:animate="none"
>
  <div class="mx-auto flex max-w-page items-center gap-x-8 px-4 py-2 sm:justify-between sm:px-8 sm:py-3 md:justify-start">
    <!-- Hidden on phones so the four nav labels fit on one row; "Home" covers it. -->
    <p class="hidden shrink-0 sm:block md:w-44">{profile.data.name}</p>
    <nav aria-label="Main" class="w-full sm:w-auto">
      <ul class="flex justify-between gap-x-6 sm:justify-start">
        {
          nav.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="inline-block py-1"
                aria-current={isCurrent(href) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <!-- Phones: the header rule fills with page progress (global.css). -->
  <span aria-hidden="true" class="header-progress"></span>
</header>
