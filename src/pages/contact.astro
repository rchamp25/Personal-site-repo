---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

// Every entry in src/content/links.yaml. Only real links (not placeholders,
// with an href) become anchors; placeholders show their text as written.
const links = (await getCollection("links")).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Contact" label="Contact">
  <h1 class="text-5xl leading-[1.05] sm:text-6xl">Contact</h1>
  <!-- The page's single accent use. Decorative. -->
  <div aria-hidden="true" class="mt-6 w-16 border-t-2 border-accent"></div>

  <dl class="mt-12 max-w-measure border-t border-hairline">
    {
      links.map(({ data }) => (
        <div class="border-b border-hairline py-4 sm:grid sm:grid-cols-[8rem_minmax(0,1fr)] sm:items-baseline sm:gap-x-6">
          <dt class="font-meta text-xs uppercase tracking-wider text-muted">{data.label}</dt>
          <dd class="mt-1 text-lg sm:mt-0">
            {!data.placeholder && data.href ? <a href={data.href}>{data.text}</a> : data.text}
          </dd>
        </div>
      ))
    }
  </dl>
</Base>
