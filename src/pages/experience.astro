---
import { getCollection, getEntry } from "astro:content";
import ExperienceRow from "../components/ExperienceRow.astro";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";

const entries = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

const groups = [
  { id: "education", heading: "Education", kind: "education" },
  { id: "roles", heading: "Roles", kind: "role" },
  { id: "achievements", heading: "Achievements", kind: "achievement" },
] as const;

// Running index in the margin: the resume, then the groups that have entries.
const sections = [
  { id: "resume", label: "Resume" },
  ...groups
    .filter(({ kind }) => entries.some((e) => e.data.kind === kind))
    .map(({ id, heading }) => ({ id, label: heading })),
];

const profile = await getEntry("profile", "ross");
if (!profile) throw new Error('Missing profile entry "ross" in src/content/profile.yaml');
const { resume } = profile.data;
---

<Base
  title="Experience"
  label="Experience"
  sections={sections}
  description="Education, roles, and achievements of {name}."
>
  <h1 class="text-5xl leading-[1.05] sm:text-6xl">Experience</h1>
  <!-- The page's single accent use. Decorative. -->
  <div aria-hidden="true" class="mt-6 w-16 border-t-2 border-accent"></div>

  <!-- The resume first (Ross's choice), then the groups. -->
  <section aria-labelledby="resume" class="mt-12 md:mt-16" data-reveal>
    <h2 id="resume" class="font-meta text-xs uppercase tracking-wider text-muted">Resume</h2>
    {
      resume.href ? (
        <p class="mt-4">
          <a
            href={resume.href}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-3 border border-hairline px-4 py-3 font-meta text-sm no-underline transition-[border-color] duration-(--duration-hover) ease-(--ease-out-quart) hover:border-muted"
          >
            {resume.label}
            <Icon name="external" class="size-3.5" />
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </p>
      ) : (
        <p class="mt-4">{resume.label}</p>
      )
    }
  </section>

  {
    groups.map(({ id, heading, kind }) => {
      const items = entries.filter((e) => e.data.kind === kind);
      return (
        items.length > 0 && (
          <section aria-labelledby={id} class="mt-12 md:mt-16">
            <h2 id={id} class="font-meta text-xs uppercase tracking-wider text-muted" data-reveal>
              {heading}
            </h2>
            <ul class="draw-rule mt-4 border-t border-hairline">
              {items.map((entry) => (
                <ExperienceRow entry={entry} />
              ))}
            </ul>
          </section>
        )
      );
    })
  }
</Base>
