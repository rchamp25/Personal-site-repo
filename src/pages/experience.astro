---
import { getCollection, getEntry } from "astro:content";
import ExperienceRow from "../components/ExperienceRow.astro";
import Base from "../layouts/Base.astro";

const entries = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

const groups = [
  { id: "education", heading: "Education", kind: "education" },
  { id: "roles", heading: "Roles", kind: "role" },
  { id: "achievements", heading: "Achievements", kind: "achievement" },
] as const;

const profile = await getEntry("profile", "ross");
if (!profile) throw new Error('Missing profile entry "ross" in src/content/profile.yaml');
const { resume } = profile.data;
---

<Base title="Experience" label="Experience">
  <h1 class="text-5xl leading-[1.05] sm:text-6xl">Experience</h1>
  <!-- The page's single accent use. Decorative. -->
  <div aria-hidden="true" class="mt-6 w-16 border-t-2 border-accent"></div>

  {
    groups.map(({ id, heading, kind }) => {
      const items = entries.filter((e) => e.data.kind === kind);
      return (
        items.length > 0 && (
          <section aria-labelledby={id} class="mt-12 md:mt-16">
            <h2 id={id} class="font-meta text-xs uppercase tracking-wider text-muted">
              {heading}
            </h2>
            <ul class="mt-4 border-t border-hairline">
              {items.map((entry) => (
                <ExperienceRow entry={entry} />
              ))}
            </ul>
          </section>
        )
      );
    })
  }

  <section aria-labelledby="resume" class="mt-12 md:mt-16">
    <h2 id="resume" class="font-meta text-xs uppercase tracking-wider text-muted">Resume</h2>
    {
      resume.href ? (
        <p class="mt-4">
          <a href={resume.href}>{resume.label}</a>
        </p>
      ) : (
        <p class="mt-4">{resume.label}</p>
      )
    }
  </section>
</Base>
