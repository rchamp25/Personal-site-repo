---
import { getCollection, type CollectionEntry } from "astro:content";
import Icon from "../../components/Icon.astro";
import ProjectBreakdown from "../../components/ProjectBreakdown.astro";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { title, summary, role, start, stack, demo, commentary } = project.data;

// Meta description: the summary once it is real, a plain line until then.
const description = project.data.placeholder ? `${title}, a project by {name}.` : summary;

// Running index in the margin: only sections this project has (the breakdown
// shows details when any of role, dates, or stack exists).
const hasDetails = Boolean(role || start || stack.length > 0);
const sections = [
  { id: "problem", label: "The problem" },
  { id: "built", label: "What I built" },
  ...(hasDetails ? [{ id: "details", label: "Details" }] : []),
  ...(commentary ? [{ id: "commentary", label: "Commentary" }] : []),
];
---

<Base title={title} label="Projects" sections={sections} description={description}>
  <article>
    <h1 class="text-5xl leading-[1.05] sm:text-6xl">
      <!-- The title span is shared with the project's row title on Home, so the
           title morphs between pages. Inline-block keeps both boxes
           text-shaped. With a live site (`demo`), the title links to it in a
           new tab. -->
      {
        demo ? (
          <a href={demo} target="_blank" rel="noopener" class="decoration-2">
            <span
              class="inline-block [text-decoration:inherit]"
              transition:name={`project-${project.id}`}
              transition:animate="initial"
            >
              {title}
            </span>
            <Icon name="external" class="ml-2 inline-block size-5 align-super text-muted sm:size-6" />
            <span class="sr-only">(live site, opens in a new tab)</span>
          </a>
        ) : (
          <span class="inline-block" transition:name={`project-${project.id}`} transition:animate="initial">
            {title}
          </span>
        )
      }
    </h1>
    <!-- The page's single accent use. Decorative. -->
    <div aria-hidden="true" class="mt-6 w-16 border-t-2 border-accent"></div>
    <ProjectBreakdown project={project} />
  </article>
</Base>
