---
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import Headshot from "../components/Headshot.astro";
import Measure from "../components/Measure.astro";
import ProjectRow from "../components/ProjectRow.astro";
import Base from "../layouts/Base.astro";
import { getProjects } from "../lib/projects";

const profile = await getEntry("profile", "ross");
if (!profile) throw new Error('Missing profile entry "ross" in src/content/profile.yaml');
const { name, role, bio, note, photo } = profile.data;

// One span per word for the first-load stagger. The spaces stay as text, so
// the heading still reads as the plain name.
const nameWords = name.split(/\s+/);

// Up to four featured projects, by order (hidden ones never show).
const featured = (await getProjects()).filter(({ data }) => data.featured).slice(0, 4);

// "Tools I've used": every entry in src/content/tools.yaml, by order.
const tools = (await getCollection("tools")).sort((a, b) => a.data.order - b.data.order);
---

<!-- No left margin column on Home (Base without a label): the content spans
     the full page width. First load only (global.css, data-intro): the name
     word by word from 80ms, the photo at 200ms, the oxide rule draws at
     280ms, then role, bio, and note, and Highlights at 600ms; all settled
     by about 840ms. The only staggered load on the site. -->
<Base>
  <!-- Intro: text, then the photo. Phones: the photo shows first, full width,
       fading out at the bottom. From lg: text left, photo right, fading into
       the ground on its left and bottom edges. -->
  <div
    id="intro"
    class:list={[
      "flex flex-col",
      "lg:grid lg:grid-cols-[minmax(0,1fr)_26rem] lg:gap-x-10 xl:grid-cols-[minmax(0,1fr)_30rem]",
    ]}
  >
    <Measure class="lg:col-start-1 lg:row-start-1">
      <h1 class="text-5xl leading-[1.05] sm:text-6xl md:text-7xl">
        {
          nameWords.map((word, i) => (
            <>
              {i > 0 && " "}
              <span class="inline-block" data-intro style={`--intro-delay: ${80 + i * 80}ms`}>
                {word}
              </span>
            </>
          ))
        }
      </h1>
      <!-- The page's accent rule. Decorative. -->
      <div
        aria-hidden="true"
        class="mt-6 w-16 border-t-2 border-accent"
        data-intro="draw"
        style="--intro-delay: 280ms"
      >
      </div>
      <p class="mt-6 text-xl sm:text-2xl" data-intro style="--intro-delay: 360ms">{role}</p>
      <p class="mt-8 text-lg leading-relaxed" data-intro style="--intro-delay: 440ms">{bio}</p>
      <p
        class="mt-10 border-l border-hairline pl-4 leading-relaxed text-muted"
        data-intro
        style="--intro-delay: 520ms"
      >
        {note}
      </p>
    </Measure>
    {
      photo && (
        // Shared with Contact (Headshot.astro): square, no filter, 2px oxide
        // frame matching the rule under the name (Ross's choice).
        <Headshot
          photo={photo}
          sizes="(min-width: 1280px) 30rem, (min-width: 1024px) 26rem, (min-width: 640px) 36rem, 100vw"
          eager
          class="hero-photo order-first mb-10 lg:order-none lg:col-start-2 lg:row-start-1 lg:mb-0"
          data-intro
          style="--intro-delay: 200ms"
        />
      )
    }
    {
      // No photo yet: a labeled placeholder holds the photo's place, so the
      // layout stays ready. Shorter on phones so it does not push the name
      // far down.
      !photo && (
        <div
          class="order-first mb-10 lg:order-none lg:col-start-2 lg:row-start-1 lg:mb-0"
          data-intro
          style="--intro-delay: 200ms"
        >
          <div class="flex aspect-[16/9] w-full items-center justify-center border border-hairline lg:aspect-auto lg:h-[min(calc(100svh-10rem),46rem)]">
            <p class="font-meta text-xs uppercase tracking-wider text-muted">
              Placeholder: new photo coming
            </p>
          </div>
        </div>
      )
    }
  </div>

  {
    featured.length > 0 && (
      <section
        aria-labelledby="highlights"
        class="mt-16 md:mt-24"
        data-intro
        style="--intro-delay: 600ms"
      >
        <h2 id="highlights" class="font-meta text-xs uppercase tracking-wider text-muted">
          Highlights
        </h2>
        <ul class="draw-rule mt-4 border-t border-hairline">
          {featured.map(({ id, data }) => (
            <ProjectRow
              slug={id}
              title={data.title}
              summary={data.summary}
              start={data.start}
              stack={data.stack}
            />
          ))}
        </ul>
      </section>
    )
  }

  {
    // Official full-color logos with the name under each (Ross's choice: an
    // exception to DESIGN.md's no-logo-wall rule and one-accent palette).
    // Static, not links. The name says what each logo is, so the logo itself
    // has empty alt text.
    tools.length > 0 && (
      <section aria-labelledby="tools-used" class="mt-16 md:mt-24" data-reveal>
        <h2 id="tools-used" class="font-meta text-xs uppercase tracking-wider text-muted">
          Tools I’ve used
        </h2>
        <ul class="tools draw-rule mt-4 grid grid-cols-3 gap-x-4 gap-y-10 border-t border-hairline pt-10 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">
          {tools.map(({ data }) => (
            <li class="tool flex flex-col items-center gap-3 text-center">
              <Image src={data.logo} alt="" loading="lazy" class="tool-logo size-10 object-contain sm:size-12" />
              <span class="tool-name font-meta text-xs text-muted">{data.name}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  /* Tools I've used: the logo under the pointer (or finger) lifts and
     grows a little and its name brightens to ink; the others dim so it stands
     out. Hover only where hover exists; press works everywhere (Base's
     touchstart listener enables :active on iOS). Reduced motion: the global
     rule drops the transitions and sets --shift-hover to 0 and --scale-hover
     to 1, so only the brightening and dimming remain. */
  .tool {
    transition: opacity var(--duration-hover) var(--ease-out-quart);
  }

  .tool-logo {
    transition:
      translate var(--duration-hover) var(--ease-out-quart),
      scale var(--duration-hover) var(--ease-out-quart);
  }

  .tool-name {
    transition: color var(--duration-hover) var(--ease-out-quart);
  }

  .tool:active .tool-logo {
    translate: 0 calc(-1 * var(--shift-hover));
    /* Three times the site's hover scale (1.06): 1.02 is invisible at 48px. */
    scale: calc(1 + 3 * (var(--scale-hover) - 1));
  }

  .tool:active .tool-name {
    color: var(--color-ink);
  }

  .tools:has(.tool:active) .tool:not(:active) {
    opacity: 0.4;
  }

  @media (hover: hover) {
    .tool:hover .tool-logo {
      translate: 0 calc(-1 * var(--shift-hover));
      scale: calc(1 + 3 * (var(--scale-hover) - 1));
    }

    .tool:hover .tool-name {
      color: var(--color-ink);
    }

    .tools:has(.tool:hover) .tool:not(:hover) {
      opacity: 0.4;
    }
  }
</style>
