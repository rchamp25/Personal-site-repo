---
import { Picture } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import Measure from "../components/Measure.astro";
import ProjectRow from "../components/ProjectRow.astro";
import Base from "../layouts/Base.astro";

const profile = await getEntry("profile", "ross");
if (!profile) throw new Error('Missing profile entry "ross" in src/content/profile.yaml');
const { name, role, bio, note, photo } = profile.data;

// One span per word for the first-load stagger. The spaces stay as text, so
// the heading still reads as the plain name.
const nameWords = name.split(/\s+/);

const featured = (await getCollection("projects", ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// Running index in the margin.
const sections = [
  { id: "intro", label: "Introduction" },
  ...(featured.length > 0 ? [{ id: "selected-work", label: "Selected work" }] : []),
];
---

<!-- First load only (global.css, data-intro): the section label at 0ms, the
     name word by word from 80ms, the oxide rule draws at 280ms, then role,
     bio, and note, and Selected work at 600ms; all settled by about 840ms.
     The only staggered load on the site. -->
<Base label="Home" intro sections={sections}>
  <!-- Intro: text, then the photo. Phones: the photo shows first, full width,
       fading out at the bottom. From lg: text left, photo right, fading into
       the ground on its left and bottom edges. -->
  <div
    id="intro"
    class:list={[
      "flex flex-col",
      photo && "lg:grid lg:grid-cols-[minmax(0,1fr)_26rem] lg:gap-x-10 xl:grid-cols-[minmax(0,1fr)_30rem]",
    ]}
  >
    <Measure class="lg:col-start-1 lg:row-start-1">
      <h1 class="text-5xl leading-[1.05] sm:text-6xl md:text-7xl">
        {
          nameWords.map((word, i) => (
            <>
              {i > 0 && " "}
              <span class="inline-block" data-intro style={`--intro-delay: ${80 + i * 80}ms`}>
                {word}
              </span>
            </>
          ))
        }
      </h1>
      <!-- The page's accent rule. Decorative. It steps back to hairline while a
           project row below holds the accent (global.css, data-page-accent). -->
      <div
        aria-hidden="true"
        class="mt-6 w-16 border-t-2 border-accent"
        data-page-accent
        data-intro="draw"
        style="--intro-delay: 280ms"
      >
      </div>
      <p class="mt-6 text-xl sm:text-2xl" data-intro style="--intro-delay: 360ms">{role}</p>
      <p class="mt-8 text-lg leading-relaxed" data-intro style="--intro-delay: 440ms">{bio}</p>
      <p
        class="mt-10 border-l border-hairline pl-4 leading-relaxed text-muted"
        data-intro
        style="--intro-delay: 520ms"
      >
        {note}
      </p>
    </Measure>
    {
      photo && (
        <div
          class="hero-photo order-first -mx-4 mb-10 sm:mx-0 lg:order-none lg:col-start-2 lg:row-start-1 lg:mb-0"
          data-intro
          style="--intro-delay: 200ms"
        >
          <Picture
            src={photo.src}
            alt={photo.alt}
            formats={["avif", "webp"]}
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 1280px) 30rem, (min-width: 1024px) 26rem, (min-width: 640px) 36rem, 100vw"
            loading="eager"
            fetchpriority="high"
            class="block aspect-[3/4] h-auto w-full object-cover object-top lg:aspect-auto lg:h-[min(calc(100svh-10rem),46rem)]"
          />
        </div>
      )
    }
  </div>

  {
    featured.length > 0 && (
      <section
        aria-labelledby="selected-work"
        class="mt-16 md:mt-24"
        data-intro
        style="--intro-delay: 600ms"
      >
        <h2 id="selected-work" class="font-meta text-xs uppercase tracking-wider text-muted">
          Selected work
        </h2>
        <ul class="draw-rule mt-4 border-t border-hairline">
          {featured.map(({ id, data }) => (
            <ProjectRow
              slug={id}
              title={data.title}
              summary={data.summary}
              start={data.start}
              stack={data.stack}
            />
          ))}
        </ul>
      </section>
    )
  }
</Base>


<style>
  /* The photo meets the ground with short, crisp fades: barely at the top
     (and right from lg), a little more at the bottom (and left from lg).
     A slight lift in saturation and contrast keeps it vivid against the
     dark ground. */
  .hero-photo :global(img) {
    filter: contrast(1.06) saturate(1.15);
    mask-image: linear-gradient(to bottom, transparent, #000 2%, #000 88%, transparent);
  }

  @media (min-width: 64rem) {
    .hero-photo :global(img) {
      mask-image:
        linear-gradient(to right, transparent, #000 8%, #000 97%, transparent),
        linear-gradient(to bottom, transparent, #000 2%, #000 88%, transparent);
      mask-composite: intersect;
    }
  }
</style>
